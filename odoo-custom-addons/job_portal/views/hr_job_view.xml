<odoo>
    <record id="view_hr_jo_inherit_form" model="ir.ui.view">
        <field name="name">hr.job.inherit.form</field>
        <field name="model">hr.job</field>
        <field name="inherit_id" ref="hr.view_hr_job_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='no_of_recruitment']"
                   position="after">
                <field name="job_sector_id" />
                <!-- <field name="job_section_id"/> -->
                <field name="job_type"/>
                <field name="closing_date"/>
                <field name="offered_salary_type"/>
                <field name="study_field"/>
                <field name="experience_req" required="1"/>
                <field name="min_salary" attrs="{'invisible':[('offered_salary_type', '!=', 'range')]}"/>
                <field name="max_salary" attrs="{'invisible':[('offered_salary_type', '!=', 'range')]}"/>
                <field name="fix_salary" attrs="{'invisible':[('offered_salary_type', '!=', 'fixed')]}"/>
                <field name="skill_ids" widget="many2many_tags"/>
            </xpath>
        </field>
    </record>
    <record id="view_grp_job_form" model="ir.ui.view">
        <field name="name">hr.job.inherit.form.grp</field>
        <field name="model">hr.job</field>
        <field name="inherit_id" ref="hr.view_hr_job_form"/>
        <field name="priority">36</field>
        <!-- <field name="groups_id" eval="[(4, ref('job_backend.job_portal_employer_group'))]"/> -->
        <field name="arch" type="xml">
            <xpath expr="//field[@name='address_id']"
                   position="replace">
                <field name="address_id" readonly="1" options="{'no_create': True, 'no_open': True}"/>
            </xpath>
            <xpath expr="//field[@name='user_id']"
                   position="replace">
                <field name="user_id" readonly="1" options="{'no_create': True, 'no_open': True}"/>
            </xpath>
        </field>
</record>

</odoo>
