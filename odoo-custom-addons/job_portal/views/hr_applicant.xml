<odoo>
    <data>
        <record id="crm_case_form_view_job_inheirt" model="ir.ui.view">
            <field name="name">crm.case.form.view.job</field>
            <field name="model">hr.applicant</field>
            <field name="inherit_id" ref="hr_recruitment.hr_applicant_view_form"/>
            <field name="arch" type="xml">
                <field name="partner_id" position="attributes">
                    <attribute name="string">Applicant</attribute>
                </field>

                <field name="description" position="before">
                    <notebook>
                        <page string="Personal Info">
                            <group>

                                <group string=" Address"
                                      >
                                    <field name="street_ht"
                                           />
                                    <field name="street2_ht"/>
                                    <field name="city_ht"
                                           />
                                    <field name="zip_ht"
                                           />
                                    <field name="state_id_ht"
                                           />


                                </group>

                                <group string="Status">
                                    <field name="gender" required="True"/>
                                    <field name="marital" required="True"/>
                                </group>
                                <group string="Birth">
                                    <field name="birthday" required="True"/>
                                </group>

                            </group>
                        </page>

                        <page string="Academic Experiences"
                              groups="base.group_user,base.group_hr_user">
                            <field name="academic_ids"
                                   context="{'default_employee_id': active_id}">
                                <tree string="Academic Experiences">
                                    <field name="name" string="Qualification"/>
                                    <field name="study_field"/>
                                    <field name="organization"
                                           string="Institution"/>
                                    <field name="location"/>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                    <field name="grade"/>
                                </tree>
                                <form string="Academic Experience">
                                    <group>
                                        <group name="main">
                                            <field name="name"
                                                   string="Qualification"/>
                                            <field name="study_field"/>
                                            <field name="start_date"/>
                                            <field name="is_still"
                                                   string="Present"/>
                                            <field name="end_date"
                                                   attrs="{'invisible':[('is_still', '=', True)]}"/>
                                            <field name="grade"/>
                                        </group>
                                        <group>
                                            <field name="organization"
                                                   string="Institution"/>
                                            <field name="location"/>
                                        </group>
                                    </group>
                                    <separator string="Activities"
                                               colspan="4"/>
                                    <field name="activities"/>
                                    <separator string="Description"
                                               colspan="4"/>
                                    <field name="description" colspan="4"
                                           nolabel="1"/>
                                </form>
                            </field>
                        </page>

                        <page string="Professional Experiences"
                              groups="base.group_user,base.group_hr_user">
                            <field name="experience_ids"
                                   context="{'default_applicant_id': active_id}">
                                <tree string="Professional Experiences">
                                    <field name="name" string="Position"/>
                                    <field name="organization"
                                           string="Employer"/>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                </tree>
                                <form string="Professional Experience">
                                    <group>
                                        <group name="main">
                                            <field name="name"
                                                   string="Position"/>
                                            <field name="organization"
                                                   string="Employer"/>
                                            <field name="location"/>
                                            <field name="type"
                                                   string="Work Type"/>
                                        </group>
                                        <group>
                                            <field name="start_date"/>
                                            <field name="is_still"
                                                   string="Present"/>
                                            <field name="end_date"
                                                   attrs="{'invisible':[('is_still', '=', True)]}"/>
                                            
                                        </group>
                            
                                    </group>
                                    <separator string="Description"
                                               colspan="4"/>
                                    <field name="description" colspan="4"
                                           nolabel="1"/>
                                </form>
                            </field>
                        </page>

                        <page string="Certifications"
                              groups="base.group_user,base.group_hr_user">
                            <field name="certification_ids"
                                   context="{'default_applicant_id': active_id}">
                                <tree string="Certifications">
                                    <field name="name" string="Certification"/>
                                    <field name="certification"
                                           string="# Certificate"/>
                                    <field name="organization"
                                           string="Issued By"/>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                </tree>
                                <form string="Certifications">
                                    <group>
                                        <group name="main">
                                            <field name="name"
                                                   string="Certification"/>
                                            <field name="certification"
                                                   string="# Certification"/>
                                            <field name="start_date"/>
                                            <field name="is_still"/>
                                            <field name="end_date" attrs="{'invisible':[('is_still', '=', True)]}"/>
                                        </group>
                                        <group>
                                            <field name="organization"
                                                   string="Issued By"/>
                                            <field name="location"/>
                                        </group>
                                    </group>
                                    <separator string="Description"
                                               colspan="4"/>
                                    <field name="description" colspan="4"
                                           nolabel="1"/>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </field>
            </field>

        </record>




        <record model="ir.ui.view" id="hr_applicant_fields_view_form_inherit">
            <field name="name">hr.applicant.form</field>
            <field name="model">hr.applicant</field>
            <field name="inherit_id" ref="hr_recruitment.hr_applicant_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='birthday']" position="after">
                    <field name="driving_license"/>
                    <field name="ssn"/>
                    <field name="citizen_restriction"/>
                </xpath>
                <notebook position="inside">

                    <page string="Position Desired" groups="base.group_user,base.group_hr_user">
                        <group>
                            <field name="position_desired"/>
                            <field name="other_position_desired"/>
                        </group>
                    </page>
                    <page string="PERSONAL INFORMATION" groups="base.group_user,base.group_hr_user">
                        <group>
                            <field name="driving_license"/>
                            <field name="ssn"/>
                            <field name="citizen_restriction"/>
                        </group>
                    </page>
                    <page string="EMERGENY INFORMATION" groups="base.group_user,base.group_hr_user">
                    <group>
                        <group string="Contact 1">
                            <!-- Contact 1 -->
                            <field name="emergency_contact_1"/>
                            <field name="emergency_relation_1"/>
                            <field name="emergency_phone_1"/>
                        </group>
                    <group  string="Contact 2">
                            <!-- Contact 2 -->
                            <field name="emergency_contact_2"/>
                            <field name="emergency_relation_2"/>
                            <field name="emergency_phone_2"/>
                    </group>
                
                    <group string="Contact 3">
                            <!-- Contact 3 -->
                            <field name="emergency_contact_3"/>
                            <field name="emergency_relation_3"/>
                            <field name="emergency_phone_3"/>
                        </group>
                    </group>
                    </page>
                    <page string="PROFESSIONAL LIABILITY INSURANCE" groups="base.group_user,base.group_hr_user">
                        <group>
                            <field name="pl_insurance_name"/>
                            <field name="pl_insurance_start_date"/>
                            <field name="pl_insurance_end_date"/>
                            <field name="insurance_history"/>
                            <field name="insurance_history_details"/>
                        </group>
                    </page>
                    <page string="SKILLS / TRAININGS ATTENDED" groups="base.group_user,base.group_hr_user">
                        <group>
                            <group string="SKILL 1">
                                <field name="skill_date_1"/>
                                <field name="skill_name_1"/>
                            </group>
                            <group string="SKILL 2">
                                <field name="skill_date_2"/>
                                <field name="skill_name_2"/>
                            </group>
                            <group string="SKILL 3">
                                <field name="skill_date_3"/>
                                <field name="skill_name_3"/>
                            </group>
                            <group string="SKILL 4">
                                <field name="skill_date_4"/>
                                <field name="skill_name_4"/>
                            </group>
                        </group>
                        <group>
                            <group>
                                <field name="cpr_expiration_date"/>
                                <field name="last_physical_exam_date"/>
                                <field name="last_xray_date"/>
                            </group>
                        </group>
                    </page>
                    <page string="References" groups="base.group_user,base.group_hr_user">
                       <group>
                            <group string="Reference 1">
                                <field name="reference_name1"/>
                                <field name="reference_rln1"/>
                                <field name="reference_cmpny1"/>
                                <field name="reference_contact1" widget="phone"/>
                            </group>
                            <group string="Reference 2">
                                <field name="reference_name2"/>
                                <field name="reference_rln2"/>
                                <field name="reference_cmpny2"/>
                                <field name="reference_contact2" widget="phone"/>
                            </group>
                            <group string="Reference 3">
                                <field name="reference_name3"/>
                                <field name="reference_rln3"/>
                                <field name="reference_cmpny3"/>
                                <field name="reference_contact3" widget="phone"/>
                            </group>
                            <group string="Reference 4">
                                <field name="reference_name4"/>
                                <field name="reference_rln4"/>
                                <field name="reference_cmpny4"/>
                                <field name="reference_contact4" widget="phone"/>
                            </group>
                    </group>
                    </page>
                    <page string="General information fields" groups="base.group_user,base.group_hr_user">
                        <group>
                            <group>
                                <field name="age_validation"/>
                                <field name="employed_home_health"/>
                            </group>
                            <group>
                                <field name="means_of_transportation"/>
                                <field name="driving_licens"/>
                                <field name="state_driving_license"/>
                                <field name="license_expiry"/>
                                <field name="driving_licens_revoke"/>
                                <field name="driving_license_revoke_reason"/>
                            </group>
                            <group>
                                <field name="task_without_accom"/>
                                <field name="task_without_accom_reason"/>
                            </group>
                            <group>
                                <field name="facility_from_state"/>
                            </group>
                            <group>
                                <field name="other_business"/>
                                <field name="other_business_reason"/>
                            </group>
                            <group>
                                <field name="military_service"/>
                            </group>
                            <group>
                                <field name="law_violation"/>
                                <field name="law_violation_reason"/>
                            </group>
                            <group>
                                <field name="hear_from"/>
                            </group>
                            
                        </group>
                    </page>
                </notebook>
            </field>
        </record>


        
        <record id="update_sorry" model="website.page">
            <field name="url">/job-update-sorry</field>
            <field name="website_published">True</field>
            <field name="name">Job Submission</field>
            <field name="type">qweb</field>
            <field name="key">job_portal.update_sorry</field>
            <field name="arch" type="xml">
                <t name="Job Submission" t-name="job_portal.update_sorry">
                    <t t-call="website.layout">
                        <div id="wrap">
                            <div class="oe_structure">
                                <div class="container">
                                    <div class="row">
                                        <div class="col-lg-12">
                                            <h1 class="text-center">Thank You!</h1>
                                            <p class="text-center">
                                                Your application has been submitted already.You can not edit the application after submission.
                                            </p>
                                        </div>
                                        <t t-if="request.session.get('form_builder_model_model', '') == 'hr.applicant'">
                                            <t t-set="job" t-value="request.website._website_form_last_record().sudo().job_id"/>
                                            <t t-set="responsible" t-value="job and job.user_id.website_published and job.user_id "/>
                                        </t>
                                        <t t-if="responsible">
                                            <div class="col-lg-12">
                                                <h3 class="mb32 text-center">Your application has been sent to:</h3>
                                            </div>
                                            <div class="col-lg-1 offset-lg-4">
                                                <p t-field="responsible.image_small" t-options="{'widget': 'image', 'class': 'rounded-circle d-block mx-auto'}"/>
                                            </div>
                                            <div class="col-lg-5 o_responsible_data">
                                                <h4 class="mt0" t-field="responsible.name"/>
                                                <p t-field="responsible.function"/>
                                                <t t-if='responsible.email'>
                                                    <i class="fa fa-envelope" role="img" aria-label="Email" title="Email"></i> <a t-attf-href="mailto:#{responsible.email}" t-esc="responsible.email"/>
                                                </t>
                                                <t t-if='responsible.phone'>
                                                    <br/><i class="fa fa-phone" role="img" aria-label="Phone" title="Phone"></i> <span t-field="responsible.phone"/>
                                                </t>
                                            </div>
                                            <div class="col-lg-12 mt32 text-center">
                                                <span>
                                                    We usually reply between one and three days.<br/>
                                                    Feel free to contact him/her if you have further questions.
                                                </span>
                                            </div>
                                        </t>
                                    </div>
                                    <div class="row" id="o_recruitment_thank_cta">
                                        <div class="col-lg-12 text-center mt32 mb32">
                                            In the meantime,
                                            <h3 class="mt8 mb32">Look around on our website:</h3>
                                            <a role="button" href="/" class="btn btn-primary btn-lg">Continue To Our Website</a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </t>
            </field>
        </record>
    </data>
</odoo>
